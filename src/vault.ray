// raypass — the vault: one encrypted file, whole-file AEAD.
//
// On disk: {"salt": hex, "nonce": hex, "box": base64} where box =
// ChaCha20-Poly1305(key = HKDF(salt, passphrase, "raypass-v1"), nonce,
// aad = "raypass", plaintext = JSON {name: {value, updated_ms}}). Every save
// draws a fresh nonce and goes through temp + rename (atomic). A wrong
// passphrase fails AEAD authentication — there is no oracle beyond open().
//
// Durability and concurrency (raylang M115): the temp file is fsync'ed
// before the rename (survives a power cut, not only a crash), the vault is
// chmod 0o600 after every save and load() warns when it finds it more
// permissive, and a sibling LOCK file (flock) serializes the read-modify-
// write of concurrent raypass processes.
//
// Honest limit (recorded finding): secrets pass through GC-managed strings
// with no way to zeroize them (a conscious raylang design decision, recorded
// in its SECURITY.md).
import std/fs;
import std/time;
import std/crypto;
import std/hex;
import std/base64;
import std/json;
from std/json import Json;

pub struct Entry {
    name: string,
    value: string,
    updated_ms: int,
}

pub struct Vault {
    entries: [Entry],
}

fn derive_key(passphrase: string, salt: bytes) -> bytes {
    match (crypto.hkdf_sha256(salt, passphrase.to_bytes(), "raypass-v1".to_bytes(), 32)) {
        Option.Some(k) => k,
        Option.None => b"",
    }
}

fn entries_to_json(v: Vault) -> string {
    var m: Map<string, Json> = Map.new();
    for e in v.entries {
        var em: Map<string, Json> = Map.new();
        em.insert("value", Json.JStr(e.value));
        em.insert("updated_ms", Json.JNum(e.updated_ms as float));
        m.insert(e.name, Json.JObject(em));
    }
    json.stringify(Json.JObject(m))
}

fn entries_from_json(s: string) -> Result<Vault, string> {
    let j = json.parse(s)?;
    var out: [Entry] = [];
    match (json.as_object(j)) {
        Option.Some(m) => {
            for name in m.keys() {
                match (get(m, name)) {
                    Option.Some(em) => {
                        let value = match (json.get_string(em, "value")) {
                            Option.Some(v) => v,
                            Option.None => "",
                        };
                        let updated = match (json.get_int(em, "updated_ms")) {
                            Option.Some(n) => n,
                            Option.None => 0,
                        };
                        out.push(Entry { name: name, value: value, updated_ms: updated });
                    },
                    Option.None => { },
                }
            }
        },
        Option.None => {
            return Result.Err("vault payload is not an object");
        },
    }
    Result.Ok(Vault { entries: out })
}

pub fn save(path: string, passphrase: string, v: Vault) -> Result<int, string> {
    let salt = crypto.random_bytes(16);
    let nonce = crypto.random_bytes(12);
    let key = derive_key(passphrase, salt);
    let sealed = match (crypto.chacha20poly1305_seal(
        key,
        nonce,
        "raypass".to_bytes(),
        entries_to_json(v).to_bytes()
    )) {
        Option.Some(b) => b,
        Option.None => {
            return Result.Err("seal failed");
        },
    };
    var m: Map<string, Json> = Map.new();
    m.insert("salt", Json.JStr(hex.hex_encode(salt)));
    m.insert("nonce", Json.JStr(hex.hex_encode(nonce)));
    m.insert("box", Json.JStr(base64.base64(sealed)));
    let tmp = path + ".tmp";
    let h = fs.open(tmp, "w")?;
    let written = fs.write(h, json.stringify(Json.JObject(m)));
    // fsync BEFORE the rename: otherwise a power cut can leave an empty vault.
    let synced = fs.sync(h);
    close(h);
    written?;
    synced?;
    fs.rename(tmp, path)?;
    // A vault is a secret: owner-only (M115.3; rename resets to the umask).
    fs.chmod(path, 0o600)
}

// The 12 permission bits as the usual octal text ("644").
fn octal(mode: int) -> string {
    var out = "";
    var m = mode;
    while (m > 0 || out.len() < 3) {
        out = to_string(m % 8) + out;
        m = m / 8;
    }
    out
}

// A warning when the vault is readable by group/others (like ssh does with
// private keys); None when the mode is 0o600 or stricter.
pub fn permission_warning(path: string) -> Option<string> {
    match (fs.stat(
    path
)) {
        Result.Ok(st) => {
            if ((st.mode & 0o77) != 0) {
                Option.Some(
                    "vault " + path + " is readable by others (mode " + octal(st.mode) + "); fixing it to 0600 on next save"
                )
            } else {
                Option.None
            }
        },
        Result.Err(e) => Option.None,
    }
}

// Exclusive advisory lock on a sibling LOCK file (the vault itself changes
// inode on every rename, so it cannot carry the lock). Release with unlock().
pub fn lock(path: string) -> Result<int, string> {
    let h = fs.open(path + ".lock", "a")?;
    match (fs.try_lock(h)) {
        Result.Ok(acquired) => {
            if (acquired) {
                Result.Ok(h)
            } else {
                close(h);
                Result.Err("vault is in use by another raypass process")
            }
        },
        Result.Err(e) => {
            close(h);
            Result.Err(e)
        },
    }
}

pub fn unlock(h: int) {
    close(h);
}

fn hex_field(j: Json, k: string) -> Result<bytes, string> {
    match (json.get_string(j, k)) {
        Option.Some(s) => {
            match (hex.hex_decode(s)) {
                Result.Ok(b) => Result.Ok(b),
                Result.Err(e) => Result.Err("bad " + k),
            }
        },
        Option.None => Result.Err("missing " + k),
    }
}

pub fn load(path: string, passphrase: string) -> Result<Vault, string> {
    let src = fs.read_file(path)?;
    let j = json.parse(src)?;
    let salt = hex_field(j, "salt")?;
    let nonce = hex_field(j, "nonce")?;
    let boxed = match (json.get_string(j, "box")) {
        Option.Some(s) => {
            match (base64.base64_decode(s)) {
                Result.Ok(b) => b,
                Result.Err(e) => {
                    return Result.Err("bad box");
                },
            }
        },
        Option.None => {
            return Result.Err("missing box");
        },
    };
    let key = derive_key(passphrase, salt);
    match (crypto.chacha20poly1305_open(key, nonce, "raypass".to_bytes(), boxed)) {
        Option.Some(plain) => {
            let s = from_utf8(plain)?;
            entries_from_json(s)
        },
        Option.None => Result.Err("wrong passphrase (or corrupted vault)"),
    }
}

pub fn empty() -> Vault {
    var entries: [Entry] = [];
    Vault { entries: entries }
}

pub fn find(v: Vault, name: string) -> Option<string> {
    for e in v.entries {
        if (e.name == name) {
            return Option.Some(e.value);
        }
    }
    Option.None
}

pub fn upsert(v: Vault, name: string, value: string) {
    var kept: [Entry] = [];
    for e in v.entries {
        if (e.name != name) {
            kept.push(e);
        }
    }
    kept.push(Entry { name: name, value: value, updated_ms: time.now() });
    v.entries = kept;
}

pub fn remove_entry(v: Vault, name: string) -> bool {
    var kept: [Entry] = [];
    var found = false;
    for e in v.entries {
        if (e.name == name) {
            found = true;
        } else {
            kept.push(e);
        }
    }
    v.entries = kept;
    found
}

pub const ALPHABET: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:+*";

// A generated password: letters, digits and safe punctuation, CSPRNG-backed.
// Rejection sampling: a byte is only used when it falls below the largest
// multiple of the alphabet size, so every symbol is equally likely (plain
// `byte % 68` would favor the first 52 symbols).
pub fn generate(len: int) -> string {
    let n = ALPHABET.len();
    let limit = 256 - 256 % n;
    var out = "";
    var count = 0;
    while (count < len) {
        let raw = crypto.random_bytes(len - count + 8);
        var i = 0;
        while (i < raw.len() && count < len) {
            let b = raw[i];
            if (b < limit) {
                let idx = b % n;
                out = out + ALPHABET.substring(idx, idx + 1);
                count = count + 1;
            }
            i = i + 1;
        }
    }
    out
}
