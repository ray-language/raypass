// raypass — hidden passphrase entry. Since raylang M125 this is just
// `term.read_hidden` (stderr prompt, per-character backspace, Ctrl-C = Err):
// the ~30 handmade lines this file used to carry now live in the stdlib.
import std/term;

pub fn hidden_line(prompt: string) -> Result<string, string> {
    // Non-interactive fallback for scripts and tests.
    match (env("RAYPASS_PASSPHRASE")) {
        Option.Some(v) => {
            return Result.Ok(v);
        },
        Option.None => { },
    }
    match (term.read_hidden(prompt)) {
        Result.Ok(s) => Result.Ok(s),
        Result.Err(e) => {
            if (e == "stdin is not a terminal") {
                Result.Err("stdin is not a terminal (set RAYPASS_PASSPHRASE for scripts)")
            } else {
                Result.Err(e)
            }
        },
    }
}
