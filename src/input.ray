// raypass — hidden passphrase entry: raw mode, byte-at-a-time, no echo.
// This is the "reading a line without echo is handmade over raw" finding in
// the flesh: some 30 lines every secrets tool would have to repeat.
import std/io;
import std/term;

pub fn hidden_line(prompt: string) -> Result<string, string> {
    // Non-interactive fallback for scripts and tests.
    match (env("RAYPASS_PASSPHRASE")) {
        Option.Some(v) => {
            return Result.Ok(v);
        },
        Option.None => { },
    }
    if (!term.is_tty(0)) {
        return Result.Err("stdin is not a terminal (set RAYPASS_PASSPHRASE for scripts)");
    }
    io.ewrite(prompt);
    let out = term.raw(fn() -> string { read_hidden() })?;
    io.ewrite("\r\n");
    Result.Ok(out)
}

fn read_hidden() -> string {
    // Bytes accumulate raw and decode once at the end, so multi-byte UTF-8
    // survives; backspace pops one byte (fine for ASCII, the common case).
    var acc = b"";
    var done = false;
    while (!done) {
        match (io.read(64)) {
            Option.None => {
                done = true;
            },
            Option.Some(chunk) => {
                var i = 0;
                while (i < chunk.len() && !done) {
                    let b = chunk[i];
                    if (b == 13 || b == 10) {
                        done = true;
                    } else if (b == 127 || b == 8) {
                        if (acc.len() > 0) {
                            acc = acc.sub_bytes(0, acc.len() - 1);
                        }
                    } else if (b == 3) {
                        acc = b"";
                        done = true;
                    } else if (b >= 32 || b >= 128) {
                        acc = acc + chunk.sub_bytes(i, i + 1);
                    }
                    i = i + 1;
                }
            },
        }
    }
    match (from_utf8(acc)) {
        Result.Ok(s) => s,
        Result.Err(e) => "",
    }
}
