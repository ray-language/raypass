// Vault round trips, wrong passphrase, generation, and the sealed-box share.
import std/fs;
import vault;
import sharebox;

// A fresh vault path inside its own temp dir (remove the dir with fs.remove_all).
fn temp_vault() -> (string, string) {
    match (fs.make_temp_dir("raypass_test_")) {
        Result.Ok(dir) => (dir, dir + "/test.vault"),
        Result.Err(e) => panic(e),
    }
}

// A format-1 vault (HKDF key derivation) written by raypass before format 2,
// passphrase "legacy-pass", one entry db-password = "s3cr3t!".
const LEGACY_VAULT: string = "{\"box\":\"kA/q1qNZ7EKotrbQh06R4134uOcle52yehZWf6h/E7zziApAoRapKpc4YDbuv3naNFxsFkwYqcAXWc6SpGGz16gUuW+cl7YtKLTx+NzU\",\"nonce\":\"8b18f0d531c9a971817390cd\",\"salt\":\"cdd50f52b84dbf007a3f7e866a623300\"}";

@test
fn vault_round_trip_and_wrong_passphrase() {
    let (dir, path) = temp_vault();
    var v = vault.empty();
    vault.upsert(v, "db-password", "s3cr3t!");
    vault.upsert(v, "api-key", "ak-123");
    vault.upsert(v, "db-password", "nuevo");
    match (vault.save(path, "correcta", v)) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    assert(!fs.exists(path + ".tmp"));
    let loaded = match (vault.load(path, "correcta")) {
        Result.Ok(x) => x,
        Result.Err(e) => panic(e),
    };
    assert_eq(loaded.entries.len(), 2);
    match (vault.find(loaded, "db-password")) {
        Option.Some(val) => assert_eq(val, "nuevo"),
        Option.None => panic("missing db-password"),
    }
    match (vault.load(path, "incorrecta")) {
        Result.Err(e) => assert(e.contains("passphrase")),
        Result.Ok(x) => panic("wrong passphrase must fail"),
    }
    // The ciphertext never contains the secret in clear.
    match (fs.read_file(path)) {
        Result.Ok(raw) => {
            assert(!raw.contains("s3cr3t"));
            assert(!raw.contains("nuevo"));
            assert(!raw.contains("ak-123"));
        },
        Result.Err(e) => panic(e),
    }
    fs.remove_all(dir);
}

@test
fn remove_and_generate() {
    var v = vault.empty();
    vault.upsert(v, "a", "1");
    assert(vault.remove_entry(v, "a"));
    assert(!vault.remove_entry(v, "a"));
    assert_eq(v.entries.len(), 0);
    let p1 = vault.generate(24);
    let p2 = vault.generate(24);
    assert_eq(p1.len(), 24);
    assert(p1 != p2);
    assert_eq(vault.generate(8).len(), 8);
}

@test
fn share_round_trip_and_tamper_detection() {
    let (sec, pub_key) = sharebox.keygen();
    assert(sec != "");
    assert(pub_key != "");
    let blob = match (sharebox.seal_to(pub_key, "el secreto compartido ñ")) {
        Result.Ok(b) => b,
        Result.Err(e) => panic(e),
    };
    match (sharebox.open_from(sec, blob)) {
        Result.Ok(plain) => assert_eq(plain, "el secreto compartido ñ"),
        Result.Err(e) => panic(e),
    }
    // A different key cannot open it.
    let (sec2, pub2) = sharebox.keygen();
    match (sharebox.open_from(sec2, blob)) {
        Result.Err(e) => assert(e.contains("decrypt")),
        Result.Ok(p) => panic("foreign key must fail"),
    }
    // Tampering breaks authentication.
    let tampered = blob.substring(0, blob.len() - 2) + "AA";
    match (sharebox.open_from(sec, tampered)) {
        Result.Err(e) => { },
        Result.Ok(p) => panic("tampered blob must fail"),
    }
}

@test
fn generated_passwords_stay_in_the_alphabet() {
    let p = vault.generate(2000);
    assert_eq(p.len(), 2000);
    for c in p.chars() {
        assert(vault.ALPHABET.contains(to_string(c)));
    }
    assert_eq(vault.generate(0), "");
}

@test
fn saved_vault_is_owner_only_and_warns_when_loosened() {
    let (dir, path) = temp_vault();
    match (vault.save(path, "pw", vault.empty())) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    match (fs.stat(path)) {
        Result.Ok(st) => assert_eq(st.mode, 0o600),
        Result.Err(e) => panic(e),
    }
    match (vault.permission_warning(path)) {
        Option.None => { },
        Option.Some(w) => panic("unexpected warning: " + w),
    }
    match (fs.chmod(path, 0o644)) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    match (vault.permission_warning(path)) {
        Option.Some(w) => assert(w.contains("readable by others")),
        Option.None => panic("a 0644 vault must warn"),
    }
    // A missing vault does not warn (init creates it).
    match (vault.permission_warning(path + ".missing")) {
        Option.None => { },
        Option.Some(w) => panic("missing vault must not warn"),
    }
    fs.remove_all(dir);
}

@test
fn lock_is_exclusive_until_released() {
    let (dir, path) = temp_vault();
    let first = match (vault.lock(path)) {
        Result.Ok(h) => h,
        Result.Err(e) => panic(e),
    };
    match (vault.lock(path)) {
        Result.Err(e) => assert(e.contains("in use")),
        Result.Ok(h) => panic("second lock must fail while the first is held"),
    }
    vault.unlock(first);
    match (vault.lock(path)) {
        Result.Ok(h) => vault.unlock(h),
        Result.Err(e) => panic("lock must be free after unlock: " + e),
    }
    fs.remove_all(dir);
}

@test
fn legacy_format_1_vault_opens_and_upgrades_on_save() {
    let (dir, path) = temp_vault();
    match (fs.write_file(path, LEGACY_VAULT)) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    let v = match (vault.load(path, "legacy-pass")) {
        Result.Ok(x) => x,
        Result.Err(e) => panic(e),
    };
    assert_eq(v.format, 1);
    match (vault.find(v, "db-password")) {
        Option.Some(val) => assert_eq(val, "s3cr3t!"),
        Option.None => panic("missing db-password"),
    }
    match (vault.load(path, "wrong")) {
        Result.Err(e) => assert(e.contains("passphrase")),
        Result.Ok(x) => panic("wrong passphrase must fail on a legacy vault too"),
    }
    // Saving rewrites it as format 2 (PBKDF2), readable with the same passphrase.
    match (vault.save(path, "legacy-pass", v)) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    let raw = match (fs.read_file(path)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    };
    assert(raw.contains("\"kdf\":\"pbkdf2-sha256\""));
    assert(raw.contains("\"iter\":600000"));
    assert(raw.contains("\"v\":2"));
    let upgraded = match (vault.load(path, "legacy-pass")) {
        Result.Ok(x) => x,
        Result.Err(e) => panic(e),
    };
    assert_eq(upgraded.format, vault.FORMAT);
    match (vault.find(upgraded, "db-password")) {
        Option.Some(val) => assert_eq(val, "s3cr3t!"),
        Option.None => panic("entry lost in the upgrade"),
    }
    // A vault from a newer raypass is refused, not misread.
    match (fs.write_file(path, raw.replace("\"v\":2", "\"v\":3"))) {
        Result.Ok(n) => { },
        Result.Err(e) => panic(e),
    }
    match (vault.load(path, "legacy-pass")) {
        Result.Err(e) => assert(e.contains("unsupported vault format")),
        Result.Ok(x) => panic("format 3 must be refused"),
    }
    fs.remove_all(dir);
}
